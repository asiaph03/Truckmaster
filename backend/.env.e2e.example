# Task #6 — E2E-only environment variables. These are NEVER read from
# backend/.env (which may be a live production configuration) — they
# must be set explicitly in your shell (or CI job env) before running
# `npm run test:e2e:bootstrap` or `npm run test:e2e`.
#
# backend/test/e2e-env-guard.ts hard-fails immediately if any required
# variable below is missing, or if a value doesn't look like an isolated
# test resource (e.g. a database name containing "prod", or a Redis URL
# matching this repo's actual production default with no DB-index path).
#
# Copy the lines you need into your shell (`export E2E_...=...` / a
# PowerShell `$env:E2E_...=...`), or into your own untracked
# `.env.e2e` file and source it yourself — this file is a reference of
# names/placeholder values only, never loaded automatically by anything.

# Requires a genuinely separate PostgreSQL database from your local dev
# DB (tms_dev) — never point this at the same database `npm run
# start:dev` uses. The name must contain one of: test, e2e, ci, local.
E2E_DATABASE_URL="postgresql://tms:<local-only-password>@127.0.0.1:5432/tms_e2e_test?schema=public"

# Must include an explicit "/<db-index>" path distinct from your normal
# dev Redis (DB 0) — BullMQ queue names are the same literal strings in
# every environment, so a distinct DB index is what actually keeps E2E
# jobs from ever being picked up by a live worker sharing the same Redis
# instance.
E2E_REDIS_URL="redis://127.0.0.1:6379/1"

# Local S3-compatible mock only (npm run s3:local / s3rver) — must never
# be a real AWS endpoint, regardless of bucket name.
E2E_S3_ENDPOINT="http://127.0.0.1:9000"
E2E_S3_BUCKET="tms-documents-e2e-test"
E2E_S3_ACCESS_KEY_ID="S3RVER"
E2E_S3_SECRET_ACCESS_KEY="S3RVER"

# Optional — sensible defaults are applied if omitted (see
# e2e-env-guard.ts): S3_REGION defaults to "us-east-1",
# S3_FORCE_PATH_STYLE defaults to "true", POSTMARK_API_KEY/FROM_ADDRESS
# default to empty (no real email can ever be sent — see
# NoopEmailSender), SESSION_SECRET defaults to a synthetic placeholder.
# MALWARE_SCAN_ENABLED is always forced to "false" for E2E regardless of
# any value here.
# E2E_S3_REGION="us-east-1"
# E2E_S3_FORCE_PATH_STYLE=true
# E2E_POSTMARK_API_KEY=
# E2E_POSTMARK_FROM_ADDRESS=
# E2E_SESSION_SECRET=
