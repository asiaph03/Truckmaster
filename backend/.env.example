# Copy to .env for local development (never commit the real .env file).
#
# Values below target the native Windows local-dev setup (README.md
# "Local Development"): PostgreSQL running natively, Memurai for Redis,
# `s3rver` (npm dev dependency, `npm run s3:local`) for object storage.
# docker-compose.yml at the repo root remains a supported alternative —
# see the S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY note below for the one
# value pair that differs between the two paths.
#
# 127.0.0.1 (not `localhost`) is used deliberately: on some Windows
# setups `localhost` resolves to the IPv6 loopback (::1) first, which can
# fail to connect if Postgres/Memurai/the local S3 server are only bound
# to the IPv4 loopback — 127.0.0.1 sidesteps that ambiguity entirely.

# Beta Launch Hardening — must be exactly "production" in any real
# deployment: it's what flips the session cookie's Secure flag on
# (configure-app.ts), which in turn requires the deployment to actually
# be served over real HTTPS (see backend/Dockerfile / frontend/Dockerfile
# / frontend/nginx.conf.template comments) — without both together,
# either cookies are insecure or they silently stop working over plain HTTP.
NODE_ENV=development
PORT=3000
# Self-hosted beta — the address the HTTP server binds to. Leave unset
# (defaults to 0.0.0.0, all interfaces) for Docker/Render, where the
# platform's reverse proxy reaches the container over its own network
# interface. Set to 127.0.0.1 only when a local reverse proxy (e.g.
# Cloudflare Tunnel) on the same machine is the sole intended entry point.
HOST=

# PostgreSQL — native Windows install, or docker-compose service `postgres`
DATABASE_URL="postgresql://tms:tms_dev_password@127.0.0.1:5432/tms_dev?schema=public"

# Redis-protocol server — Memurai (native Windows), or docker-compose
# service `redis`. Sessions (Phase 1) + BullMQ queues (malware-scan job,
# Phase 2; remaining background jobs, Phase 7).
REDIS_URL="redis://127.0.0.1:6379"

# S3-compatible object storage — `s3rver` (npm run s3:local), or
# docker-compose service `minio`. Beta Launch Hardening: in production
# this must be a REAL bucket with CORS configured to allow PUT (and its
# preflight OPTIONS) from the deployed frontend's real origin — direct
# browser uploads (Documents/POD/compliance docs/Bulk Import) fail
# without it. This value's origin is also used, unmodified, to build the
# backend's CSP connect-src directive (configure-app.ts) and must be
# passed as S3_ORIGIN to the frontend/nginx container (see
# nginx.conf.template) so its CSP allows the same uploads too.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="tms-documents"
# S3RVER/S3RVER is s3rver's own single built-in test account (see
# node_modules/s3rver/lib/models/account.js — it has no option to
# register additional credentials, and rejects any access key it doesn't
# already recognize with InvalidAccessKeyId). If you're using the
# docker-compose/MinIO alternative instead, override these two to
# tms_minio_admin / tms_minio_dev_password (matching docker-compose.yml's
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD).
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"
S3_FORCE_PATH_STYLE=true

# Session signing secret (Phase 1) — generate a real random value for any
# non-local environment; this placeholder is for local dev only.
SESSION_SECRET="dev-only-change-me"

# PRD Tracking / Workflow 6 check-call reminder cadence (Stage 6 §10.1/§17 S1).
# Fixed, non-configurable-per-organization in V1 — isolated here as a single
# constant per Stage 7 rule #10, so it can be sourced from Organization-level
# config in a future phase without an architectural change.
CHECK_CALL_REMINDER_HOURS=4

# Frontend Phase 16 — hosted malware-scanning provider (behind IMalwareScanner,
# common/malware-scan/). Leave blank for local dev. There is no stub/fallback
# scanner in this codebase — CloudmersiveMalwareScanner is always the one
# registered (document.module.ts) — so this is a genuine hard requirement in
# any real deployment: without a valid key, every uploaded document fails
# scanning and gets quarantined, and nothing becomes downloadable.
CLOUDMERSIVE_API_KEY=

# Frontend Phase 16 — hosted transactional email provider (behind IEmailSender,
# common/email/). Leave blank for local dev. There is no stub/fallback sender
# in this codebase — PostmarkEmailSender is always the one registered
# (email.module.ts) — so this is a genuine hard requirement in any real
# deployment: without a valid key and a Postmark-verified FROM_ADDRESS, no
# transactional email sends, including the invitation emails that are the
# only way to onboard a new user into an organization.
POSTMARK_API_KEY=
POSTMARK_FROM_ADDRESS=

# Vercel + Render deployment — leave both blank for local dev and for the
# Docker/nginx same-origin deployment path; neither needs cross-origin
# CORS or a widened cookie domain. Set only when the frontend (Vercel)
# and backend (Render) are on different origins under a shared parent
# domain, e.g.:
#   CORS_ORIGIN=https://yourdomain.com
#   COOKIE_DOMAIN=.yourdomain.com
# CORS_ORIGIN is the exact frontend origin allowed to make credentialed
# cross-origin requests (configure-app.ts) — never a wildcard.
# COOKIE_DOMAIN widens only the CSRF cookie's Domain attribute so
# frontend JS can read it via document.cookie across the two subdomains;
# the session cookie is never widened (csrf-bootstrap.middleware.ts).
CORS_ORIGIN=
COOKIE_DOMAIN=

# Frontend Phase 23 — the frontend's absolute origin, used to build
# clickable links in transactional emails (invitation/verification —
# MembershipService.invite/resend, OrganizationService.createOrganization).
# Leave blank for local dev (links are informational only, not clickable).
# Set to the real production frontend origin, no trailing slash, e.g.:
#   APP_BASE_URL=https://yourdomain.com
APP_BASE_URL=
