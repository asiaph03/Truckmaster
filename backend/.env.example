# Copy to .env for local development (never commit the real .env file).
# Matches docker-compose.yml at the repo root.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose service: postgres)
DATABASE_URL="postgresql://tms:tms_dev_password@localhost:5432/tms_dev?schema=public"

# Redis (docker-compose service: redis) — sessions (Phase 1) + BullMQ queues (Phase 7)
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage (docker-compose service: minio)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="tms-documents"
S3_ACCESS_KEY_ID="tms_minio_admin"
S3_SECRET_ACCESS_KEY="tms_minio_dev_password"
S3_FORCE_PATH_STYLE=true

# Session signing secret (Phase 1) — generate a real random value for any
# non-local environment; this placeholder is for local dev only.
SESSION_SECRET="dev-only-change-me"

# PRD Tracking / Workflow 6 check-call reminder cadence (Stage 6 §10.1/§17 S1).
# Fixed, non-configurable-per-organization in V1 — isolated here as a single
# constant per Stage 7 rule #10, so it can be sourced from Organization-level
# config in a future phase without an architectural change.
CHECK_CALL_REMINDER_HOURS=4
