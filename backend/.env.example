# Copy to .env for local development (never commit the real .env file).
#
# Values below target the native Windows local-dev setup (README.md
# "Local Development"): PostgreSQL running natively, Memurai for Redis,
# `s3rver` (npm dev dependency, `npm run s3:local`) for object storage.
# docker-compose.yml at the repo root remains a supported alternative —
# see the S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY note below for the one
# value pair that differs between the two paths.
#
# 127.0.0.1 (not `localhost`) is used deliberately: on some Windows
# setups `localhost` resolves to the IPv6 loopback (::1) first, which can
# fail to connect if Postgres/Memurai/the local S3 server are only bound
# to the IPv4 loopback — 127.0.0.1 sidesteps that ambiguity entirely.

NODE_ENV=development
PORT=3000

# PostgreSQL — native Windows install, or docker-compose service `postgres`
DATABASE_URL="postgresql://tms:tms_dev_password@127.0.0.1:5432/tms_dev?schema=public"

# Redis-protocol server — Memurai (native Windows), or docker-compose
# service `redis`. Sessions (Phase 1) + BullMQ queues (malware-scan job,
# Phase 2; remaining background jobs, Phase 7).
REDIS_URL="redis://127.0.0.1:6379"

# S3-compatible object storage — `s3rver` (npm run s3:local), or
# docker-compose service `minio`.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="tms-documents"
# S3RVER/S3RVER is s3rver's own single built-in test account (see
# node_modules/s3rver/lib/models/account.js — it has no option to
# register additional credentials, and rejects any access key it doesn't
# already recognize with InvalidAccessKeyId). If you're using the
# docker-compose/MinIO alternative instead, override these two to
# tms_minio_admin / tms_minio_dev_password (matching docker-compose.yml's
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD).
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"
S3_FORCE_PATH_STYLE=true

# Session signing secret (Phase 1) — generate a real random value for any
# non-local environment; this placeholder is for local dev only.
SESSION_SECRET="dev-only-change-me"

# PRD Tracking / Workflow 6 check-call reminder cadence (Stage 6 §10.1/§17 S1).
# Fixed, non-configurable-per-organization in V1 — isolated here as a single
# constant per Stage 7 rule #10, so it can be sourced from Organization-level
# config in a future phase without an architectural change.
CHECK_CALL_REMINDER_HOURS=4

# Frontend Phase 16 — hosted malware-scanning provider (behind IMalwareScanner,
# common/malware-scan/). Leave blank for local dev; required wherever
# CloudmersiveMalwareScanner is registered in place of the stub.
CLOUDMERSIVE_API_KEY=

# Frontend Phase 16 — hosted transactional email provider (behind IEmailSender,
# common/email/). Leave blank for local dev; required wherever
# PostmarkEmailSender is registered in place of the stub. FROM_ADDRESS must be
# a domain/sender verified with Postmark before real delivery will work.
POSTMARK_API_KEY=
POSTMARK_FROM_ADDRESS=
