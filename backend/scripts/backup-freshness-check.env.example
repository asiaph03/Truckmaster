# Monitoring Phase 3 — backup-freshness-check.ts configuration.
#
# Deliberately NOT part of backend/.env.example / backend/.env — this
# monitor's credentials (a read-only S3 identity + a Postmark server
# token) must stay isolated from the application's own configuration,
# matching the existing backup-verify.env pattern already used by the
# legacy pipeline (C:\TMSBackups\config\backup-verify.env) and the
# BACKUP_*/RESTORE_VERIFY_* isolation convention used by every other
# script in this directory.
#
# In production this file (with real values, never committed) lives
# outside the application repository, alongside wherever this script's
# own Scheduled Task is configured to load its environment from — not
# decided by this file, which is a template only.

# Read-only listing identity — reuse the SAME already-provisioned
# `tms-db-backup-restore` IAM credentials used by RESTORE_VERIFY_S3_*
# (backup-restore-verify.ts). This script resolves its own copy of
# these values rather than reading RESTORE_VERIFY_S3_* directly (see
# backup-freshness-check.ts's own top-of-file comment for why).
BACKUP_MONITOR_S3_ACCESS_KEY_ID=
BACKUP_MONITOR_S3_SECRET_ACCESS_KEY=
BACKUP_MONITOR_S3_BUCKET=tms-db-backups-prod-2026
BACKUP_MONITOR_S3_REGION=us-east-1

# Optional — defaults to "daily" (production behavior unchanged unless set).
# BACKUP_MONITOR_S3_PREFIX=daily

# Optional — defaults to 26 (24h expected cadence + 2h buffer).
# BACKUP_MONITOR_FRESHNESS_HOURS=26

# Postmark — a server token, isolated from the application's own
# `postmark.apiKey` (backend/src/config/configuration.ts). Using a
# separate, narrowly-scoped Postmark server for this alert is
# recommended but not required by the code itself.
BACKUP_MONITOR_POSTMARK_TOKEN=
BACKUP_MONITOR_ALERT_FROM=alerts@truckmasterdispatch.com
BACKUP_MONITOR_ALERT_TO=

# Optional — defaults to backend/.local-backups/backup-freshness-state.json
# (gitignored) for local/manual runs. Production should point this at a
# path outside both the app repo and either backup pipeline's own
# directory (e.g. a new, purpose-specific folder — decided at deployment
# time, not hardcoded here). Contains no secrets, only a status string
# and a timestamp.
# BACKUP_MONITOR_STATE_FILE=C:\TMSBackupMonitor\state\backup-freshness-state.json
