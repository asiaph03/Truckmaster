// Truck Master TMS — Prisma schema
// Source of truth for the data model: docs/DATABASE_DESIGN.md
//
// Phase 0 (Foundation): datasource + generator only.
// Phase 1 (Identity & Tenancy) — THIS FILE — adds the first models:
// User, Organization, OrganizationMembership, MembershipRole,
// OrganizationSequence — per docs/TECHNICAL_ARCHITECTURE.md §15 Phase 1
// and docs/DATABASE_DESIGN.md §2–3.
//
// Row-Level Security policies are NOT expressed here — Prisma has no RLS
// DSL. RLS policies ship as raw SQL migrations applied immediately after
// each `prisma migrate dev`/`deploy` run. See prisma/rls/README.md for the
// mechanism and policy pattern (TECHNICAL_ARCHITECTURE.md §4.6).
//
// `User` and `Organization` are the only two tables with NO organization_id
// column and NO RLS policy (DATABASE_DESIGN.md §1, §26) — every other
// model below is organization_id-scoped and RLS-protected.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums (DATABASE_DESIGN.md §2–3) — native Postgres ENUM types, per
// TECHNICAL_ARCHITECTURE.md §4.4: these are closed, locked vocabularies
// (Workflow 1), not organization-extensible, so a DB-level guarantee is
// appropriate (unlike DocumentTypeDefinition/ChargeTypeDefinition, which
// remain lookup tables starting Phase 2/6 because those ARE extensible).
// ---------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30
  NET_45
  NET_60
}

enum MembershipStatus {
  PENDING_VERIFICATION
  INVITED
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum MembershipRoleName {
  ADMIN
  OPERATIONS_MANAGER
  DISPATCHER
  SALES_BOOKING
  ACCOUNTING
  COMPLIANCE_REVIEWER
}

enum OrganizationSequenceType {
  LOAD
  QUOTE
  INVOICE
}

/// Architecture Decision 8 — reserved now, AI unused until a future phase.
enum ActorType {
  HUMAN
  SYSTEM
  AI
}

// ---------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------

/// Global identity (Architecture Decision 1). No organization_id — a
/// person's login identity is shared across every org they belong to.
model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String     @unique
  passwordHash         String?    @map("password_hash")
  name                 String
  isPlatformSuperAdmin Boolean    @default(false) @map("is_platform_super_admin")
  status               UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt      DateTime?  @map("email_verified_at")
  createdAt            DateTime   @default(now()) @map("created_at")

  // Reverse relations
  organizationsCreated   Organization[]           @relation("OrganizationCreatedBy")
  memberships            OrganizationMembership[] @relation("MembershipUser")
  invitationsSent        OrganizationMembership[] @relation("MembershipInvitedBy")
  deactivationsPerformed OrganizationMembership[] @relation("MembershipDeactivatedBy")

  // Phase 2 reverse relations
  customersOwned              Customer[]                 @relation("CustomerAccountOwner")
  customersCreated            Customer[]                 @relation("CustomerCreatedBy")
  carriersCreated             Carrier[]                  @relation("CarrierCreatedBy")
  fmcsaVerificationsPerformed CarrierFmcsaVerification[] @relation("FmcsaVerifiedBy")
  serviceAreasCreated         CarrierServiceArea[]       @relation("ServiceAreaCreatedBy")
  documentsUploaded           Document[]                 @relation("DocumentUploadedBy")
  documentsReviewed           Document[]                 @relation("DocumentReviewedBy")

  // Phase 3 reverse relations
  quotesCreated             Quote[] @relation("QuoteCreatedBy")
  loadsCreated              Load[]  @relation("LoadCreatedBy")
  loadsAssignedAsDispatcher Load[]  @relation("LoadAssignedDispatcher")
  loadsClosed               Load[]  @relation("LoadClosedBy")

  // Phase 4 reverse relations
  sourcingAttemptsLogged CarrierSourcingAttempt[] @relation("SourcingAttemptLoggedBy")
  dispatchesPerformed    DispatchRecord[]         @relation("DispatchedBy")
  checkCallsLogged       CheckCall[]              @relation("CheckCallLoggedBy")

  // Phase 6 reverse relations
  chargeLineItemsCreated  ChargeLineItem[] @relation("ChargeLineItemCreatedBy")
  invoicesCreated         Invoice[]        @relation("InvoiceCreatedBy")
  paymentsRecorded        Payment[]        @relation("PaymentRecordedBy")
  adjustmentsCreated      Adjustment[]     @relation("AdjustmentCreatedBy")
  carrierPaymentsPrepared CarrierPayment[] @relation("CarrierPaymentPreparedBy")
  carrierPaymentsApproved CarrierPayment[] @relation("CarrierPaymentApprovedBy")
  carrierPaymentsRejected CarrierPayment[] @relation("CarrierPaymentLastRejectedBy")

  @@map("user")
}

/// Tenant root. No organization_id on itself (it IS the tenant boundary);
/// no RLS policy — access is gated entirely by the application layer
/// joining through OrganizationMembership first (DATABASE_DESIGN.md §26).
model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  legalName           String             @map("legal_name")
  addressLine1        String             @map("address_line1")
  city                String
  state               String
  zip                 String
  country             String             @default("US")
  primaryContactName  String             @map("primary_contact_name")
  primaryContactEmail String             @map("primary_contact_email")
  primaryContactPhone String             @map("primary_contact_phone")
  defaultPaymentTerms PaymentTerms       @default(NET_30) @map("default_payment_terms")
  status              OrganizationStatus @default(ACTIVE)
  createdByUserId     String             @map("created_by_user_id") @db.Uuid
  createdBy           User               @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt           DateTime           @default(now()) @map("created_at")

  memberships OrganizationMembership[]
  sequences   OrganizationSequence[]

  // Phase 2 reverse relations — Customer/Carrier are direct children in the
  // relationship map (DATABASE_DESIGN.md §29), same tier as
  // OrganizationMembership, so they get a full Prisma relation + FK
  // constraint. Child/detail tables below (contacts, locations, insurance,
  // documents, etc.) intentionally do NOT — see the note above the
  // Customer model for why.
  customers               Customer[]
  carriers                Carrier[]
  documentTypeDefinitions DocumentTypeDefinition[]

  // Phase 6 — mirrors documentTypeDefinitions exactly (nullable
  // organizationId = system default). Invoice is a direct child of
  // Organization, same tier as Customer/Carrier/Quote/Load.
  chargeTypeDefinitions ChargeTypeDefinition[]
  invoices              Invoice[]

  // Phase 3 — Quote/Load are direct children of Organization (same tier
  // as Customer/Carrier), so they get a full Prisma relation here too.
  quotes Quote[]
  loads  Load[]

  @@map("organization")
}

/// A person's relationship to one organization — status, invitation
/// lifecycle, roles. RLS-protected (organization_id-scoped).
model OrganizationMembership {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation("MembershipUser", fields: [userId], references: [id])

  status MembershipStatus @default(INVITED)

  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  invitedBy       User?     @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id])
  invitedAt       DateTime? @map("invited_at")

  invitationTokenHash String?   @map("invitation_token_hash")
  invitationExpiresAt DateTime? @map("invitation_expires_at")

  activatedAt DateTime? @map("activated_at")

  deactivatedAt       DateTime? @map("deactivated_at")
  deactivatedByUserId String?   @map("deactivated_by_user_id") @db.Uuid
  deactivatedBy       User?     @relation("MembershipDeactivatedBy", fields: [deactivatedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  roles MembershipRole[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_membership")
}

/// Multi-role support (Workflow 1 §7). organization_id is denormalized
/// here (also present, redundantly with the parent membership) purely so
/// every RLS-protected table has a simple, join-free policy
/// (TECHNICAL_ARCHITECTURE.md §4.4/Decision Log D2).
model MembershipRole {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  membershipId String                 @map("membership_id") @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id])

  role MembershipRoleName

  @@unique([membershipId, role])
  @@index([organizationId])
  @@map("membership_role")
}

/// Org-scoped counter for Load/Quote/Invoice numbering (Decision Log D3).
/// Not consumed by anything yet in Phase 1 — Load/Quote/Invoice don't
/// exist until Phase 3/6 — but implemented now per the explicit Phase 1
/// entity list, with its row-locking increment method built and tested
/// (TECHNICAL_ARCHITECTURE.md §4.5/§4.7) so it's ready the moment it's
/// needed.
model OrganizationSequence {
  organizationId String                   @map("organization_id") @db.Uuid
  organization   Organization             @relation(fields: [organizationId], references: [id])
  sequenceType   OrganizationSequenceType @map("sequence_type")
  currentValue   BigInt                   @default(0) @map("current_value")

  @@id([organizationId, sequenceType])
  @@map("organization_sequence")
}

/// Universal audit log (DATABASE_DESIGN.md §23, Decision 7/Decision Log
/// D15). Explicitly called out as Phase 1 scope in
/// TECHNICAL_ARCHITECTURE.md §15 ("AuditLog/DomainEvent service — used by
/// everything after") — Workflow 1 itself requires an audit event for
/// every action it defines (Organization Created, User Invited, User
/// Activated, User Deactivated, etc.), so this is a hard dependency for
/// correctly implementing Phase 1, not scope creep.
///
/// correlationId (TECHNICAL_ARCHITECTURE.md §9.3, a ✅-confirmed Stage 6
/// addition) carries the request's requestId (RequestContext, Phase 0) so
/// every audit entry is traceable back to the API call that produced it.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @default(HUMAN) @map("actor_type")

  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid

  previousValue Json?   @map("previous_value")
  newValue      Json?   @map("new_value")
  reason        String?

  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, actorUserId, createdAt])
  @@map("audit_log")
}

/// Internal event backbone (DATABASE_DESIGN.md §24). No subscribers exist
/// yet in Phase 1 (Notification is Phase 7) — written now alongside every
/// AuditLog entry per TECHNICAL_ARCHITECTURE.md §9.1's "written
/// transactionally together...by the same service-layer call," so future
/// phases only need to *subscribe*, never touch the ~13 modules that
/// already emit events.
model DomainEvent {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  eventType  String @map("event_type")
  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid
  payload    Json

  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @default(HUMAN) @map("actor_type")

  correlationId String? @map("correlation_id")

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([organizationId, eventType, occurredAt])
  @@map("domain_event")
}

// ---------------------------------------------------------------------
// Phase 2 — Core Master Data (DATABASE_DESIGN.md §4-7)
//
// Schema-fidelity note applying to every model below: DATABASE_DESIGN.md
// lists "organization_id UUID FK → Organization" on every table. For the
// two top-level entities (Customer, Carrier — direct children of
// Organization in the relationship map, §29, same tier as
// OrganizationMembership) that FK is a real Prisma relation. For child/
// detail tables (contacts, locations, insurance, drivers/trucks/trailers,
// documents, etc.) organization_id is a plain UUID column with NO Prisma
// relation object — this mirrors the precedent already set in Phase 1 for
// AuditLog/DomainEvent (see migration 20260813122226_phase1_identity_tenancy),
// where the same choice was made to avoid an explosion of reverse-array
// noise on Organization for tables that are always actually queried
// scoped by their own more specific parent (customerId/carrierId), with
// RLS (§26) + the application-layer organization_id filter — not the FK
// constraint itself — doing the real tenant-isolation work (Decision 4).
// ---------------------------------------------------------------------

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PaymentTermsSource {
  INHERITED
  OVERRIDE
}

enum CustomerContactRole {
  BOOKING
  OPERATIONS
  BILLING
  MANAGEMENT
  OTHER
}

enum CustomerLocationType {
  PICKUP
  DELIVERY
  OTHER
}

/// Shared by CustomerRateAgreement.equipment_type, Truck.truck_type,
/// Trailer.trailer_type (DATABASE_DESIGN.md §4/§6 — same closed
/// vocabulary in all three places).
enum EquipmentType {
  DRY_VAN
  REEFER
  FLATBED
}

enum CarrierStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CarrierContactRole {
  DISPATCH
  SAFETY_COMPLIANCE
  BILLING
  FACTORING
  MANAGEMENT
  OTHER
}

enum InsuranceCoverageType {
  AUTO_LIABILITY
  CARGO
}

enum CarrierServiceAreaType {
  LANE
  REGION
}

enum DocumentEntityType {
  LOAD
  STOP
  CUSTOMER
  CARRIER
  DRIVER
  TRUCK
  TRAILER
  INVOICE
  CARRIER_PAYMENT
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  SCAN_FAILED
}

enum DocumentReviewStatus {
  NOT_APPLICABLE
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

/// Matches the two groupings in PRD §9 (Decision Log D13).
enum DocumentTypeCategory {
  LOAD
  CARRIER_COMPLIANCE
}

/// DATABASE_DESIGN.md §4. Workflow 2 §2.1 — always starts at Prospect
/// regardless of who creates it or how complete the record is.
model Customer {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  legalName String @map("legal_name")

  billingAddressLine1 String @map("billing_address_line1")
  billingCity         String @map("billing_city")
  billingState        String @map("billing_state")
  billingZip          String @map("billing_zip")
  billingCountry      String @default("US") @map("billing_country")

  primaryContactName  String @map("primary_contact_name")
  primaryContactEmail String @map("primary_contact_email")
  primaryContactPhone String @map("primary_contact_phone")

  status CustomerStatus @default(PROSPECT)

  accountOwnerUserId String? @map("account_owner_user_id") @db.Uuid
  accountOwner       User?   @relation("CustomerAccountOwner", fields: [accountOwnerUserId], references: [id])

  paymentTerms       PaymentTerms       @map("payment_terms")
  paymentTermsSource PaymentTermsSource @map("payment_terms_source")

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts       CustomerContact[]
  locations      CustomerLocation[]
  rateAgreements CustomerRateAgreement[]

  // Phase 3 reverse relations
  quotes Quote[]
  loads  Load[]

  // Phase 6 reverse relation
  invoices Invoice[]

  @@index([organizationId, status])
  @@index([organizationId, legalName])
  @@map("customer")
}

model CustomerContact {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  name  String
  email String?
  phone String?

  role      CustomerContactRole
  isPrimary Boolean             @default(false) @map("is_primary")

  @@index([organizationId, customerId])
  @@map("customer_contact")
}

model CustomerLocation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  name String

  addressLine1 String @map("address_line1")
  city         String
  state        String
  zip          String
  country      String @default("US")

  locationType CustomerLocationType @map("location_type")

  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  operatingHours          String? @map("operating_hours")
  appointmentRequirements String? @map("appointment_requirements")
  notes                   String?

  // Phase 3 reverse relation — Stop.customerLocationId, when a Load's
  // stop reuses a saved Customer location.
  stops Stop[]

  @@index([organizationId, customerId])
  @@map("customer_location")
}

model CustomerRateAgreement {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  originCity  String @map("origin_city")
  originState String @map("origin_state")

  destinationCity  String @map("destination_city")
  destinationState String @map("destination_state")

  equipmentType EquipmentType @map("equipment_type")

  rate     Decimal @db.Decimal(12, 2)
  rateType String  @map("rate_type")

  effectiveDate  DateTime  @map("effective_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date

  fuelSurchargeRules String? @map("fuel_surcharge_rules")
  notes              String?

  // Phase 3 reverse relations — Workflow 4 §4.4 Rate Agreement matching.
  quotesUsingRate Quote[]
  loadsUsingRate  Load[]

  @@index([organizationId, customerId])
  @@map("customer_rate_agreement")
}

/// DATABASE_DESIGN.md §5. Workflow 3 §3.1 — always starts PENDING /
/// assignment_eligible=false; §3.2's MC/DOT uniqueness is a hard block,
/// enforced here at the DB level too (not just app-layer) via the
/// composite unique constraints below.
model Carrier {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  legalName String  @map("legal_name")
  dba       String?

  mcNumber  String @map("mc_number")
  dotNumber String @map("dot_number")

  addressLine1 String @map("address_line1")
  city         String
  state        String
  zip          String

  primaryContactName  String @map("primary_contact_name")
  primaryContactPhone String @map("primary_contact_phone")
  primaryContactEmail String @map("primary_contact_email")

  status               CarrierStatus @default(PENDING)
  assignmentEligible   Boolean       @default(false) @map("assignment_eligible")
  ineligibilityReasons Json?         @map("ineligibility_reasons")

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("CarrierCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  contacts           CarrierContact[]
  insuranceRecords   CarrierInsurance[]
  fmcsaVerifications CarrierFmcsaVerification[]
  serviceAreas       CarrierServiceArea[]
  factoringInfo      CarrierFactoringInfo?
  drivers            Driver[]
  trucks             Truck[]
  trailers           Trailer[]

  // Phase 3 reverse relation — Load.assignedCarrierId (Phase 4 populates).
  assignedLoads Load[]

  // Phase 4 reverse relation
  sourcingAttempts CarrierSourcingAttempt[]

  // Phase 6 reverse relation
  carrierPayments CarrierPayment[]

  @@unique([organizationId, mcNumber])
  @@unique([organizationId, dotNumber])
  @@index([organizationId, assignmentEligible])
  @@index([organizationId, status])
  @@map("carrier")
}

model CarrierContact {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  name  String
  email String?
  phone String?

  role      CarrierContactRole
  isPrimary Boolean            @default(false) @map("is_primary")

  @@index([organizationId, carrierId])
  @@map("carrier_contact")
}

/// Workflow 3 §3.6/§3.9 — structured coverage records, separate from the
/// supporting COI `Document`, so expiration/eligibility never depend on
/// parsing an uploaded file (§3.9's explicit clarification).
model CarrierInsurance {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  coverageType     InsuranceCoverageType @map("coverage_type")
  coverageAmount   Decimal               @map("coverage_amount") @db.Decimal(12, 2)
  insuranceCompany String                @map("insurance_company")
  agentContact     String?               @map("agent_contact")

  effectiveDate  DateTime @map("effective_date") @db.Date
  expirationDate DateTime @map("expiration_date") @db.Date

  coiDocumentId String   @map("coi_document_id") @db.Uuid
  coiDocument   Document @relation("CarrierInsuranceCoiDocument", fields: [coiDocumentId], references: [id])

  @@index([organizationId, carrierId])
  @@map("carrier_insurance")
}

model CarrierFmcsaVerification {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  verificationDate DateTime @map("verification_date") @db.Date
  resultStatus     String   @map("result_status")

  verifiedByUserId String @map("verified_by_user_id") @db.Uuid
  verifiedBy       User   @relation("FmcsaVerifiedBy", fields: [verifiedByUserId], references: [id])

  authorityInfo String? @map("authority_info")
  notes         String?

  @@index([organizationId, carrierId])
  @@map("carrier_fmcsa_verification")
}

/// DATABASE_DESIGN.md §5, Decision Log D16 (Stage 5 addendum) — pure
/// storage/display data, no matching/scoring logic, no bearing on
/// assignment_eligible.
model CarrierServiceArea {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  type CarrierServiceAreaType

  originCity  String? @map("origin_city")
  originState String? @map("origin_state")

  destinationCity  String? @map("destination_city")
  destinationState String? @map("destination_state")

  regionLabel String? @map("region_label")
  notes       String?

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("ServiceAreaCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, carrierId])
  @@map("carrier_service_area")
}

/// Workflow 3 §3.11 — informational only, no eligibility linkage.
model CarrierFactoringInfo {
  carrierId String  @id @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  organizationId String @map("organization_id") @db.Uuid

  usesFactoring       Boolean @default(false) @map("uses_factoring")
  factoringCompany    String? @map("factoring_company")
  remitToAddress      String? @map("remit_to_address")
  factoringContact    String? @map("factoring_contact")
  paymentInstructions String? @map("payment_instructions")
  noaStatus           String? @map("noa_status")

  noaDocumentId String?   @map("noa_document_id") @db.Uuid
  noaDocument   Document? @relation("CarrierFactoringNoaDocument", fields: [noaDocumentId], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carrier_factoring_info")
}

/// DATABASE_DESIGN.md §6 — lightweight, carrier-linked, reusable records.
/// Compliance fields (CDL, medical card, HOS, ELD, drug/alcohol)
/// explicitly NOT in V1 schema (§28) — future columns, not new tables.
model Driver {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String
  email     String?

  licenseNumber String? @map("license_number")
  notes         String?
  active        Boolean @default(true)

  // Phase 4 reverse relation — DispatchRecord.sourceDriverId, when dispatch
  // snapshots this record (snapshot only, not a live reference — §6.2).
  dispatchRecordsSourced DispatchRecord[] @relation("DispatchSourceDriver")

  @@index([organizationId, carrierId])
  @@map("driver")
}

model Truck {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  unitNumber String        @map("unit_number")
  truckType  EquipmentType @map("truck_type")

  make  String?
  model String?
  year  Int?

  vin   String?
  plate String?

  active Boolean @default(true)
  notes  String?

  // Phase 4 reverse relation — DispatchRecord.sourceTruckId (snapshot only).
  dispatchRecordsSourced DispatchRecord[] @relation("DispatchSourceTruck")

  @@index([organizationId, carrierId])
  @@map("truck")
}

model Trailer {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  unitNumber  String        @map("unit_number")
  trailerType EquipmentType @map("trailer_type")

  vin   String?
  plate String?

  active Boolean @default(true)
  notes  String?

  // Phase 4 reverse relation — DispatchRecord.sourceTrailerId (snapshot only).
  dispatchRecordsSourced DispatchRecord[] @relation("DispatchSourceTrailer")

  @@index([organizationId, carrierId])
  @@map("trailer")
}

/// DATABASE_DESIGN.md §7, Decision Log D13 — lookup table (not a fixed
/// enum) because the PRD requires org-level custom document types.
/// organization_id nullable = system-provided default, available to
/// every organization (seeded at deploy time — prisma/seed.ts).
model DocumentTypeDefinition {
  id String @id @default(uuid()) @db.Uuid

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  category DocumentTypeCategory
  code     String
  label    String

  requiresReview  Boolean @default(false) @map("requires_review")
  isSystemDefault Boolean @default(false) @map("is_system_default")

  documents Document[]

  @@index([organizationId, category])
  @@map("document_type_definition")
}

/// DATABASE_DESIGN.md §7 — universal, polymorphic, versioned. Per
/// Architecture Decision 3 (generic polymorphic columns) and Decision 10
/// (mandatory malware scanning, gates download).
///
/// entity_id has NO native FK (explicit in DATABASE_DESIGN.md §7 —
/// "Application-layer-validated (no native FK across polymorphic
/// types)") since entity_type varies; entity existence/access is checked
/// in DocumentService, not the database.
model Document {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// Stable across every version of "the same document" (Decision Log D4).
  documentFamilyId String @default(uuid()) @map("document_family_id") @db.Uuid

  entityType DocumentEntityType @map("entity_type")
  entityId   String             @map("entity_id") @db.Uuid

  documentTypeId  String                 @map("document_type_id") @db.Uuid
  documentType    DocumentTypeDefinition @relation(fields: [documentTypeId], references: [id])
  customTypeLabel String?                @map("custom_type_label")

  fileStorageKey String @map("file_storage_key")
  fileName       String @map("file_name")
  fileSizeBytes  BigInt @map("file_size_bytes")
  mimeType       String @map("mime_type")

  versionNumber    Int     @default(1) @map("version_number")
  isCurrentVersion Boolean @default(true) @map("is_current_version")

  scanStatus   DocumentScanStatus @default(PENDING) @map("scan_status")
  scannedAt    DateTime?          @map("scanned_at")
  scanProvider String?            @map("scan_provider")

  reviewStatus DocumentReviewStatus? @map("review_status")

  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedBy       User?     @relation("DocumentReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime? @map("reviewed_at")
  rejectionReason  String?   @map("rejection_reason")

  expirationDate DateTime? @map("expiration_date") @db.Date

  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       User     @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  carrierInsuranceCoiFor CarrierInsurance[]     @relation("CarrierInsuranceCoiDocument")
  carrierFactoringNoaFor CarrierFactoringInfo[] @relation("CarrierFactoringNoaDocument")

  @@index([organizationId, entityType, entityId, isCurrentVersion])
  @@index([organizationId, scanStatus])
  @@index([organizationId, documentFamilyId])
  @@map("document")
}

// ---------------------------------------------------------------------
// Phase 3 — Load Lifecycle Core (DATABASE_DESIGN.md §8-9)
//
// Quote/Load are top-level entities (direct children of Organization,
// same tier as Customer/Carrier — real Prisma relation to Organization).
// QuoteStop/Stop are child/detail tables (plain organizationId column, no
// direct Organization relation), following the exact Phase 2 convention
// documented above the Customer model.
// ---------------------------------------------------------------------

enum QuoteStatus {
  OPEN
  WON
  LOST
}

/// Shared by Quote.rate_source and Load.rate_source (Workflow 4 §4.4).
enum RateSource {
  MANUAL
  RATE_AGREEMENT
  MANUAL_OVERRIDE
}

/// QuoteStop's type set has no OTHER — quotes only ever need lane
/// endpoints (Workflow 4 §4.2), unlike Load's fuller Stop model.
enum QuoteStopType {
  PICKUP
  DELIVERY
}

enum BookingSource {
  QUOTE
  DIRECT
}

/// Full lifecycle (Workflows 4-6, 10). Phase 3 only ever creates a Load
/// at BOOKED — every later state is set by its owning phase.
enum LoadStatus {
  BOOKED
  CARRIER_SOURCING
  CARRIER_ASSIGNED
  RATE_CONFIRMATION
  DISPATCHED
  PICKUP
  IN_TRANSIT
  DELIVERED
  CLOSED
}

/// Persisted derived field (Workflow 7 §7.2) — Phase 5 owns the
/// derivation logic; the column exists now per the full-schema-now
/// approach (see note on Load below).
enum PodStatus {
  NOT_RECEIVED
  PARTIAL
  COMPLETE
}

/// Independent of Load.status (Workflow 6 §6.8) — Phase 4/6 owns this.
enum RiskStatus {
  NORMAL
  AT_RISK
  DELAYED
}

/// Stop's type set includes OTHER, unlike QuoteStop.
enum StopType {
  PICKUP
  DELIVERY
  OTHER
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
}

/// DATABASE_DESIGN.md §8. Workflow 4 §4.2 — non-binding, expires after
/// `expirationDate` (default now + 7 days) unless explicitly converted or
/// marked Lost first. `OPEN -> WON | LOST` is permanently terminal in
/// both directions (§4.6) — no reopening, no re-conversion, ever.
model Quote {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  quoteNumber String @map("quote_number")

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  equipmentType EquipmentType @map("equipment_type")

  customerRate Decimal    @map("customer_rate") @db.Decimal(12, 2)
  rateSource   RateSource @map("rate_source")

  /// Retained even when the suggested rate is overridden (Workflow 4
  /// §4.4 step 3b — "so the original agreement reference remains linked
  /// for historical/reporting purposes").
  rateAgreementId String?                @map("rate_agreement_id") @db.Uuid
  rateAgreement   CustomerRateAgreement? @relation(fields: [rateAgreementId], references: [id])

  status     QuoteStatus @default(OPEN)
  lossReason String?     @map("loss_reason")

  expirationDate DateTime @map("expiration_date") @db.Date

  /// Set only on conversion (Workflow 4 §4.7 step 7). Unique — a Quote
  /// converts into at most one Load ("Quote 1 -> 0..1 Load").
  resultingLoadId String? @unique @map("resulting_load_id") @db.Uuid
  resultingLoad   Load?   @relation("QuoteResultingLoad", fields: [resultingLoadId], references: [id])

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  stops      QuoteStop[]
  bookedLoad Load?       @relation("LoadOriginatingQuote")

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@map("quote")
}

/// DATABASE_DESIGN.md §8 — lane-level only (city/state/zip, no street
/// address or full appointment detail): "Quotes need only lane-level
/// info, not full appointment detail" (Workflow 4 §4.2).
model QuoteStop {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id])

  sequence Int
  stopType QuoteStopType @map("stop_type")

  addressCity  String @map("address_city")
  addressState String @map("address_state")
  addressZip   String @map("address_zip")

  appointmentNotes String? @map("appointment_notes")

  @@index([organizationId, quoteId])
  @@map("quote_stop")
}

/// DATABASE_DESIGN.md §9. Full lifecycle table, built complete now
/// (rather than ALTER-TABLE-ing it in per phase) following the same
/// precedent already set for OrganizationSequence in Phase 1: the doc
/// defines Load as one schema unit with no phase-annotation on individual
/// columns. Phase 3 (this module) only ever creates a Load at `BOOKED`
/// and sets the fields Workflow 4 owns (§4.7/§4.8); every later-phase
/// column below (assignedCarrierId, carrierRate, podStatus, riskStatus,
/// currentLocation*, currentEta, invoiced, posted*, closedAt/closedBy,
/// assignedDispatcherId) stays null/default until its owning phase
/// (4/5/6/8, per TECHNICAL_ARCHITECTURE.md §15) implements the logic that
/// populates it.
model Load {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  loadNumber String @map("load_number")

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  bookingSource BookingSource @map("booking_source")

  /// Set only when bookingSource = QUOTE (Workflow 4 §4.7). Unique — a
  /// Load originates from at most one Quote.
  quoteId String? @unique @map("quote_id") @db.Uuid
  quote   Quote?  @relation("LoadOriginatingQuote", fields: [quoteId], references: [id])

  status LoadStatus @default(BOOKED)

  equipmentType EquipmentType @map("equipment_type")

  /// Original agreed rate — never overwritten (PRD §5.2).
  customerRate Decimal    @map("customer_rate") @db.Decimal(12, 2)
  rateSource   RateSource @map("rate_source")

  rateAgreementId String?                @map("rate_agreement_id") @db.Uuid
  rateAgreement   CustomerRateAgreement? @relation(fields: [rateAgreementId], references: [id])

  /// Optional, addable at booking or any time after (Workflow 4 §4.10) —
  /// never required to reach BOOKED.
  customerPoNumber        String? @map("customer_po_number")
  bolNumber               String? @map("bol_number")
  pickupNumber            String? @map("pickup_number")
  customerReferenceNumber String? @map("customer_reference_number")

  /// Phase 4 (Sourcing & Dispatch) fields — unpopulated by Phase 3.
  assignedCarrierId String?  @map("assigned_carrier_id") @db.Uuid
  assignedCarrier   Carrier? @relation(fields: [assignedCarrierId], references: [id])
  carrierRate       Decimal? @map("carrier_rate") @db.Decimal(12, 2)

  /// Independent action per Workflow 4 §4.11 — always NULL at booking
  /// regardless of path; set by a future Dispatch-assignment endpoint,
  /// not this module.
  assignedDispatcherId String? @map("assigned_dispatcher_id") @db.Uuid
  assignedDispatcher   User?   @relation("LoadAssignedDispatcher", fields: [assignedDispatcherId], references: [id])

  /// Phase 5 (POD & Documents Completion) — persisted derived field.
  podStatus PodStatus @default(NOT_RECEIVED) @map("pod_status")

  /// Phase 4/6 — independent of `status` (Workflow 6 §6.8).
  riskStatus RiskStatus @default(NORMAL) @map("risk_status")
  riskReason String?    @map("risk_reason")

  currentLocationCity        String?   @map("current_location_city")
  currentLocationState       String?   @map("current_location_state")
  currentLocationZip         String?   @map("current_location_zip")
  currentLocationDescription String?   @map("current_location_description")
  currentLocationUpdatedAt   DateTime? @map("current_location_updated_at")
  currentEta                 DateTime? @map("current_eta")

  /// Phase 6 (Financials) — prevents double-billing (Workflow 8 §8.1).
  invoiced Boolean @default(false)

  /// External load-board placeholder (PRD §6.3.9) — Phase 4+.
  postedExternally Boolean? @map("posted_externally")
  postingPlatform  String?  @map("posting_platform")
  postingStatus    String?  @map("posting_status")
  postingNotes     String?  @map("posting_notes")

  /// Phase 6 (Load Closing, Workflow 10).
  closedAt       DateTime? @map("closed_at")
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  closedBy       User?     @relation("LoadClosedBy", fields: [closedByUserId], references: [id])

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("LoadCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stops         Stop[]
  resultOfQuote Quote? @relation("QuoteResultingLoad")

  // Phase 4 reverse relations
  sourcingAttempts CarrierSourcingAttempt[]
  dispatchRecord   DispatchRecord?
  checkCalls       CheckCall[]

  // Phase 6 reverse relations
  chargeLineItems         ChargeLineItem[]
  invoiceLoads            InvoiceLoad[]
  invoiceLineItemsSourced InvoiceLineItem[] @relation("InvoiceLineItemSourceLoad")
  carrierPayments         CarrierPayment[]

  @@unique([organizationId, loadNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, assignedDispatcherId])
  @@map("load")
}

/// DATABASE_DESIGN.md §9. Phase 3 only creates Stops as input data at
/// booking time (location/address/appointment) — arrival/departure
/// recording, the PENDING/ARRIVED/COMPLETED lifecycle, and the derived
/// Load-status transitions that consume `status`/`actualArrival`/
/// `actualDeparture` all belong to Workflow 6 / Phase 4
/// (TECHNICAL_ARCHITECTURE.md §6.3 deriveLoadStatus) — not this module.
model Stop {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  loadId String @map("load_id") @db.Uuid
  load   Load   @relation(fields: [loadId], references: [id])

  sequence Int
  stopType StopType @map("stop_type")

  /// If reused from the customer's saved locations — address fields
  /// below are still always populated inline, a snapshot at time of
  /// booking (DATABASE_DESIGN.md §9), even when copied from here.
  customerLocationId String?           @map("customer_location_id") @db.Uuid
  customerLocation   CustomerLocation? @relation(fields: [customerLocationId], references: [id])

  /// addressLine1 is nullable specifically because a Load booked via
  /// Quote conversion (Workflow 4 §4.7) carries forward QuoteStop rows,
  /// which are deliberately lane-level only (city/state/zip — §4.2's
  /// "quotes need only lane-level info, not full appointment detail") and
  /// never captured a street address. Direct-to-Booked stops (§4.8)
  /// always populate it. city/state/zip remain required either way.
  addressLine1 String? @map("address_line1")
  city         String
  state        String
  zip          String

  appointmentDatetime DateTime? @map("appointment_datetime")
  actualArrival       DateTime? @map("actual_arrival")
  actualDeparture     DateTime? @map("actual_departure")

  status StopStatus @default(PENDING)

  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  notes        String?

  @@index([loadId, sequence])
  @@index([organizationId, loadId])
  @@map("stop")
}

// ---------------------------------------------------------------------
// Phase 4 — Sourcing & Dispatch (DATABASE_DESIGN.md §10-12)
//
// CarrierSourcingAttempt and CheckCall are child/detail tables (plain
// organizationId column, no direct Organization relation), following the
// same Phase 2/3 convention documented above the Customer model.
// DispatchRecord is also a child/detail table, keyed 1:1 on loadId itself
// (mirroring the CarrierFactoringInfo precedent) rather than getting its
// own surrogate id.
// ---------------------------------------------------------------------

/// Workflow 5 §5.5 — every attempt (assigned, declined, no-response,
/// quoted, rejected-after-assignment) is its own permanent row, never
/// overwritten.
enum SourcingAttemptOutcome {
  ASSIGNED
  DECLINED
  NO_RESPONSE
  QUOTED
  REJECTED_AFTER_ASSIGNMENT
}

/// Workflow 6 §6.7.
enum CheckCallOnTimeStatus {
  ON_TIME
  LATE
  UNKNOWN
}

/// DATABASE_DESIGN.md §10. Workflow 5 §5.4/§5.5/§5.6 — permanent sourcing
/// history. The row created automatically at assignment (§5.4) and the row
/// updated (not deleted) on rejection (§5.6) are the same mechanism as
/// manually-logged attempts (§5.5) — one model, three write paths, always
/// append-only except for the single in-place rejection update.
model CarrierSourcingAttempt {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  loadId String @map("load_id") @db.Uuid
  load   Load   @relation(fields: [loadId], references: [id])

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  carrierRate Decimal? @map("carrier_rate") @db.Decimal(12, 2)

  outcome SourcingAttemptOutcome

  rejectionReason String? @map("rejection_reason")

  loggedByUserId String @map("logged_by_user_id") @db.Uuid
  loggedBy       User   @relation("SourcingAttemptLoggedBy", fields: [loggedByUserId], references: [id])

  loggedAt DateTime @default(now()) @map("logged_at")

  @@index([organizationId, loadId])
  @@index([organizationId, carrierId])
  @@map("carrier_sourcing_attempt")
}

/// DATABASE_DESIGN.md §11, Decision Log D8. Mutable, current-state only —
/// history lives in AuditLog (Workflow 6 §6.9's explicit language).
/// driverName/driverPhone/truckNumber/trailerNumber are snapshotted values
/// (Workflow 6 §6.2), not references — sourceDriverId/sourceTruckId/
/// sourceTrailerId are optional provenance links only, kept purely so the
/// UI can offer "reuse this Carrier's records" convenience; editing or
/// deactivating the underlying Driver/Truck/Trailer after dispatch never
/// changes this row.
model DispatchRecord {
  loadId String @id @map("load_id") @db.Uuid
  load   Load   @relation(fields: [loadId], references: [id])

  organizationId String @map("organization_id") @db.Uuid

  driverName    String @map("driver_name")
  driverPhone   String @map("driver_phone")
  truckNumber   String @map("truck_number")
  trailerNumber String @map("trailer_number")

  sourceDriverId String? @map("source_driver_id") @db.Uuid
  sourceDriver   Driver? @relation("DispatchSourceDriver", fields: [sourceDriverId], references: [id])

  sourceTruckId String? @map("source_truck_id") @db.Uuid
  sourceTruck   Truck?  @relation("DispatchSourceTruck", fields: [sourceTruckId], references: [id])

  sourceTrailerId String?  @map("source_trailer_id") @db.Uuid
  sourceTrailer   Trailer? @relation("DispatchSourceTrailer", fields: [sourceTrailerId], references: [id])

  dispatchedByUserId String   @map("dispatched_by_user_id") @db.Uuid
  dispatchedBy       User     @relation("DispatchedBy", fields: [dispatchedByUserId], references: [id])
  dispatchedAt       DateTime @default(now()) @map("dispatched_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("dispatch_record")
}

/// DATABASE_DESIGN.md §12. Workflow 6 §6.7 — structured tracking log,
/// gated to Load.status DISPATCHED or later. Load.riskStatus/riskReason
/// (Workflow 6 §6.8) live directly on Load (already present from Phase 3),
/// not here — a single current value, not a history.
model CheckCall {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  loadId String @map("load_id") @db.Uuid
  load   Load   @relation(fields: [loadId], references: [id])

  loggedByUserId String @map("logged_by_user_id") @db.Uuid
  loggedBy       User   @relation("CheckCallLoggedBy", fields: [loggedByUserId], references: [id])

  occurredAt DateTime @map("occurred_at")

  contactMethod   String @map("contact_method")
  personContacted String @map("person_contacted")

  locationCity  String? @map("location_city")
  locationState String? @map("location_state")
  locationZip   String? @map("location_zip")

  eta DateTime?

  onTimeStatus CheckCallOnTimeStatus @map("on_time_status")

  notes String?

  @@index([organizationId, loadId])
  @@map("check_call")
}

// ---------------------------------------------------------------------
// Phase 6 — Financials (DATABASE_DESIGN.md §14-18)
//
// ChargeTypeDefinition mirrors DocumentTypeDefinition's exact lookup-table
// pattern (Decision Log D13). Invoice is a direct child of Organization
// (same tier as Customer/Carrier/Quote/Load, per DATABASE_DESIGN.md §29's
// relationship map) and gets a full Prisma relation to both Organization
// and Customer. ChargeLineItem, InvoiceLoad, InvoiceLineItem, Payment,
// and Adjustment are child/detail tables (plain organizationId column, no
// direct Organization relation), following the same Phase 2/3 convention
// documented above the Customer model. CarrierPayment is also a
// child/detail table (of Load + Carrier), mirroring the
// CarrierSourcingAttempt precedent from Phase 4 exactly.
// ---------------------------------------------------------------------

/// DATABASE_DESIGN.md §14. Independent revenue/cost line items (PRD §8).
enum ChargeLineItemSide {
  CUSTOMER
  CARRIER
}

/// Original booking/assignment-time linehaul vs. a later accessorial
/// addition (Decision Log D9).
enum ChargeLineItemSource {
  ORIGINAL
  ADJUSTMENT
}

/// TECHNICAL_ARCHITECTURE.md §6.9. OVERDUE is deliberately absent — never
/// stored, always computed at read time (Workflow 8 §8.10, Decision 5).
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
  CREDITED
}

/// Workflow 8 §8.11.
enum AdjustmentType {
  CREDIT
  DEBIT
}

/// PRD §8 / Workflow 9 §9.2.
enum CarrierPaymentType {
  DEPOSIT
  PARTIAL
  BALANCE
  ADJUSTMENT
}

/// TECHNICAL_ARCHITECTURE.md §6.8. No REJECTED terminal state — rejection
/// loops PENDING_APPROVAL back to DRAFT (Workflow 9 §9.4-§9.5), may cycle
/// any number of times.
enum CarrierPaymentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

/// DATABASE_DESIGN.md §14, Decision Log D13. Management (create/edit) is
/// Admin-only (Decision Log B3); *using* an existing type to add a charge
/// to a Load is available to a broader role set (Decision Log D9) — two
/// distinct permissions governing two distinct actions, per
/// TECHNICAL_ARCHITECTURE.md §4.11's explicit "D9 vs. B3, kept distinct"
/// note.
model ChargeTypeDefinition {
  id String @id @default(uuid()) @db.Uuid

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  code  String
  label String

  isSystemDefault Boolean @default(false) @map("is_system_default")

  chargeLineItems ChargeLineItem[]

  @@index([organizationId])
  @@map("charge_type_definition")
}

/// DATABASE_DESIGN.md §14, Decision Log D9. Add-only — no locked source
/// document describes an edit or delete operation anywhere; every
/// addition is a new permanent row, consistent with the PRD's Financial
/// Integrity Principle ("nothing is silently overwritten"). No `stop_id`
/// column (Decision Log B2 — charges remain load-level only in V1).
model ChargeLineItem {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  loadId String @map("load_id") @db.Uuid
  load   Load   @relation(fields: [loadId], references: [id])

  side ChargeLineItemSide

  chargeTypeId String               @map("charge_type_id") @db.Uuid
  chargeType   ChargeTypeDefinition @relation(fields: [chargeTypeId], references: [id])

  description String?

  quantity Decimal @default(1) @db.Decimal(10, 2)
  unitRate Decimal @map("unit_rate") @db.Decimal(12, 2)
  amount   Decimal @db.Decimal(12, 2)

  source ChargeLineItemSource

  notes String?

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("ChargeLineItemCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  invoiceLineItemsSourcedFrom InvoiceLineItem[] @relation("InvoiceLineItemSourceChargeLineItem")

  @@index([organizationId, loadId])
  @@map("charge_line_item")
}

/// DATABASE_DESIGN.md §15. Workflow 8 §8.7 — invoice_number generated at
/// Draft creation, not deferred to Send. `due_date` stays null until Send
/// (§8.8 — the payment clock starts at Send, not Draft). `total`/
/// `remaining_balance` are recalculated and persisted on every
/// line-item/payment/adjustment change (high-read fields, Decision 5).
model Invoice {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceNumber String @map("invoice_number")

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  status InvoiceStatus @default(DRAFT)

  sentAt  DateTime? @map("sent_at")
  dueDate DateTime? @map("due_date") @db.Date

  total            Decimal @db.Decimal(12, 2)
  remainingBalance Decimal @map("remaining_balance") @db.Decimal(12, 2)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  invoiceLoads InvoiceLoad[]
  lineItems    InvoiceLineItem[]
  payments     Payment[]
  adjustments  Adjustment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@map("invoice")
}

/// DATABASE_DESIGN.md §15 — join table supporting consolidated invoicing
/// (Workflow 8 §8.4). One-invoice-per-Load (§8.1) is enforced at the
/// application layer via the transactional `Load.invoiced` flag check —
/// exactly the mechanism Workflow 8 §8.1 itself describes. A DB-level
/// partial unique index excluding VOID invoices was considered but is not
/// expressible here: Postgres partial indexes cannot filter on a joined
/// table's column (VOID lives on `Invoice.status`, not on this table), and
/// denormalizing status onto this table was judged out of scope.
model InvoiceLoad {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  loadId String @map("load_id") @db.Uuid
  load   Load   @relation(fields: [loadId], references: [id])

  loadTotalAtInvoice Decimal @map("load_total_at_invoice") @db.Decimal(12, 2)

  @@index([organizationId, invoiceId])
  @@index([organizationId, loadId])
  @@map("invoice_load")
}

/// DATABASE_DESIGN.md §15, Decision Log D11. Individual invoices: one row
/// per underlying ChargeLineItem, snapshotted (never a live reference) so
/// later charge edits on the source Load never retroactively alter an
/// already-created invoice. Consolidated invoices: one row per Load
/// (Workflow 8 §8.5).
model InvoiceLineItem {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  description String
  amount      Decimal @db.Decimal(12, 2)

  sourceLoadId String? @map("source_load_id") @db.Uuid
  sourceLoad   Load?   @relation("InvoiceLineItemSourceLoad", fields: [sourceLoadId], references: [id])

  sourceChargeLineItemId String?         @map("source_charge_line_item_id") @db.Uuid
  sourceChargeLineItem   ChargeLineItem? @relation("InvoiceLineItemSourceChargeLineItem", fields: [sourceChargeLineItemId], references: [id])

  @@index([organizationId, invoiceId])
  @@map("invoice_line_item")
}

/// DATABASE_DESIGN.md §16. Workflow 8 §8.9 — multiple rows per invoice
/// supported natively. Cannot be recorded against a DRAFT invoice
/// (application-layer status check, not a DB constraint, since it depends
/// on a related row's current state).
model Payment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  paymentDate DateTime @map("payment_date") @db.Date

  method          String
  referenceNumber String? @map("reference_number")
  notes           String?

  recordedByUserId String @map("recorded_by_user_id") @db.Uuid
  recordedBy       User   @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, invoiceId])
  @@map("payment")
}

/// DATABASE_DESIGN.md §17. Workflow 8 §8.11 — never mutates InvoiceLineItem
/// or Invoice.total; only affects remaining_balance and derived status
/// (Financial Integrity Principle, PRD §8). No additional approval
/// workflow — same permission as invoicing generally.
model Adjustment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  type AdjustmentType

  amount Decimal @db.Decimal(12, 2)
  reason String

  adjustmentDate DateTime @map("adjustment_date") @db.Date

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("AdjustmentCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, invoiceId])
  @@map("adjustment")
}

/// DATABASE_DESIGN.md §18. Workflow 9 — amount locked at submission (not
/// editable during approval, §9.3-§9.4). Rejection returns to DRAFT, not
/// a separate REJECTED terminal state (§9.5) — only the most recent
/// rejection is stored here; full history lives in AuditLog.
/// Self-approval prevention: approvedByUserId != preparedByUserId,
/// enforced at the application layer (mirrors Document review's
/// SelfReviewForbiddenError pattern from Phase 2). No line-item
/// allocation (Decision Log D10) — always against the Load's total
/// carrier balance. total_paid/remaining_carrier_balance are computed at
/// read time from SUM(PAID CarrierPayment.amount), never a stored field.
model CarrierPayment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  loadId String @map("load_id") @db.Uuid
  load   Load   @relation(fields: [loadId], references: [id])

  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  amount      Decimal            @db.Decimal(12, 2)
  paymentType CarrierPaymentType @map("payment_type")

  method          String?
  referenceNumber String? @map("reference_number")
  notes           String?

  status CarrierPaymentStatus @default(DRAFT)

  preparedByUserId String @map("prepared_by_user_id") @db.Uuid
  preparedBy       User   @relation("CarrierPaymentPreparedBy", fields: [preparedByUserId], references: [id])

  submittedAt DateTime? @map("submitted_at")

  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedBy       User?     @relation("CarrierPaymentApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime? @map("approved_at")

  lastRejectedByUserId String?   @map("last_rejected_by_user_id") @db.Uuid
  lastRejectedBy       User?     @relation("CarrierPaymentLastRejectedBy", fields: [lastRejectedByUserId], references: [id])
  lastRejectedAt       DateTime? @map("last_rejected_at")
  lastRejectionReason  String?   @map("last_rejection_reason")

  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, loadId])
  @@index([organizationId, carrierId])
  @@index([organizationId, status])
  @@map("carrier_payment")
}
